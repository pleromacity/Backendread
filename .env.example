# ── Local development only ─────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# Option A – full ADO.NET connection string (set this in production via Key Vault)
# AZURE_SQL_CONNECTIONSTRING=Server=tcp:<server>.database.windows.net,1433;Database=booknook;Authentication=Active Directory Default;Encrypt=True;

# Option B – individual parts (SQL auth, for local dev without managed identity)
SQL_SERVER=<your-server>.database.windows.net
SQL_DATABASE=booknook
SQL_USER=<sql-admin-user>
SQL_PASSWORD=<sql-admin-password>

# Blob Storage account name (no https://, just the account name)
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>

# Server port (Azure App Service sets this automatically)
PORT=3000
